#!/usr/bin/env python3
import os, sys, time

d = os.path.expanduser(sys.argv[1] if len(sys.argv) > 1 else "~/.emacs.d-local/bebop-events")
offsets, partial = {}, {}
while True:
    try:
        names = [n for n in os.listdir(d) if n.endswith(".jsonl")]
    except OSError:
        names = []
    for n in set(offsets) - set(names):
        offsets.pop(n, None); partial.pop(n, None)
    for n in names:
        path = os.path.join(d, n)
        try:
            size = os.path.getsize(path)
        except OSError:
            continue
        off = offsets.get(n, 0)
        if size < off:
            off, partial[n] = 0, b""
        if size > off:
            with open(path, "rb") as f:
                f.seek(off)
                data = partial.get(n, b"") + f.read(size - off)
            *lines, partial[n] = data.split(b"\n")
            stem = n[:-len(".jsonl")]
            for line in lines:
                if line.strip():
                    sys.stdout.write(stem + "\t" + line.decode("utf-8", "replace") + "\n")
            sys.stdout.flush()
        offsets[n] = size
    time.sleep(0.25)
